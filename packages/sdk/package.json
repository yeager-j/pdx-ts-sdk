{
  "name": "@pdx-ts/sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK for generating Stellaris mods",
  "type": "module",
  "exports": {
    ".": {
      "pdx-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stellaris": {
      "pdx-source": "./src/stellaris/index.ts",
      "types": "./dist/stellaris/index.d.ts",
      "default": "./dist/stellaris/index.js"
    },
    "./content-registries": {
      "pdx-source": "./src/content-registries.ts",
      "types": "./dist/content-registries.d.ts",
      "default": "./dist/content-registries.js"
    },
    "./script-reference": {
      "pdx-source": "./src/script-reference.ts",
      "types": "./dist/script-reference.d.ts",
      "default": "./dist/script-reference.js"
    }
  },
  "dependencies": {
    "@pdx-ts/pdxscript": "^0.2.0"
  },
  "peerDependencies": {
    "@pdx-ts/stellaris-ids": "*"
  },
  "devDependencies": {
    "@pdx-ts/codegen-cwt": "*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeager-j/pdx-ts-sdk.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "stellaris",
    "paradox",
    "modding",
    "pdxscript",
    "typescript",
    "codegen"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "homepage": "https://github.com/yeager-j/pdx-ts-sdk/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/yeager-j/pdx-ts-sdk/issues"
  }
}
