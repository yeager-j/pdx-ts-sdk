{
  "name": "create-stellaris-mod",
  "version": "0.1.0",
  "description": "Scaffold a Stellaris mod project that builds with @pdx-ts/sdk",
  "type": "module",
  "license": "MIT",
  "bin": {
    "create-stellaris-mod": "./dist/bin.js"
  },
  "exports": {
    ".": "./src/cli.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "stellaris",
    "paradox",
    "modding",
    "scaffold",
    "create"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0"
  },
  "devDependencies": {
    "@pdx-ts/sdk": "*"
  }
}
