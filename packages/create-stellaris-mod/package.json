{
  "name": "create-stellaris-mod",
  "version": "0.4.0",
  "description": "Scaffold a Stellaris mod project that builds with @pdx-ts/sdk",
  "type": "module",
  "license": "MIT",
  "bin": {
    "create-stellaris-mod": "dist/bin.js"
  },
  "exports": {
    ".": {
      "pdx-source": "./src/cli.ts",
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "stellaris",
    "paradox",
    "modding",
    "scaffold",
    "create"
  ],
  "scripts": {
    "generate:version": "node scripts/generate-version.mjs",
    "build": "npm run generate:version && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@pdx-ts/sdk": "*",
    "@types/semver": "^7.8.0",
    "ajv": "^8.17.1",
    "eslint": "^9.39.5",
    "smol-toml": "^1.8.0",
    "typescript-eslint": "^8.66.0",
    "yaml": "^2.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeager-j/pdx-ts-sdk.git",
    "directory": "packages/create-stellaris-mod"
  },
  "homepage": "https://github.com/yeager-j/pdx-ts-sdk/tree/main/packages/create-stellaris-mod#readme",
  "bugs": {
    "url": "https://github.com/yeager-j/pdx-ts-sdk/issues"
  }
}
