{
  "name": "@pdx-ts/codegen-cwt",
  "version": "1.0.0",
  "description": "Generates @pdx-ts/sdk's committed TypeScript surface from the vendored cwtools rules and Stellaris documentation dumps",
  "type": "module",
  "private": true,
  "exports": {
    "./drift-baseline.json": "./src/drift-baseline.json",
    "./overlay": "./src/overlay/index.ts",
    "./corpus": "./src/corpus/corpus.ts",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@pdx-ts/pdxscript": "*"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
