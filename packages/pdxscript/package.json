{
  "name": "@pdx-ts/pdxscript",
  "version": "0.3.0",
  "description": "Parser and serializer for PDXScript, the Clausewitz engine script format (Stellaris-tested): order-preserving, duplicate-preserving, semantic round-trip",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "pdx-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "GRAMMAR.md"
  ],
  "keywords": [
    "paradox",
    "pdxscript",
    "clausewitz",
    "stellaris",
    "parser",
    "modding"
  ],
  "devDependencies": {
    "fast-check": "^4.9.0",
    "jomini": "^0.10.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeager-j/pdx-ts-sdk.git",
    "directory": "packages/pdxscript"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "homepage": "https://github.com/yeager-j/pdx-ts-sdk/tree/main/packages/pdxscript#readme",
  "bugs": {
    "url": "https://github.com/yeager-j/pdx-ts-sdk/issues"
  }
}
