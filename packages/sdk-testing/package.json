{
  "name": "@pdx-ts/sdk-testing",
  "version": "0.6.0",
  "description": "Test Stellaris mod logic without launching the game \u2014 a whitelist interpreter over the triggers and effects @pdx-ts/sdk records",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "pdx-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./matchers": {
      "pdx-source": "./src/matchers.ts",
      "types": "./dist/matchers.d.ts",
      "default": "./dist/matchers.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "stellaris",
    "paradox",
    "modding",
    "testing",
    "vitest"
  ],
  "peerDependencies": {
    "@pdx-ts/sdk": "^0.6.0",
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@pdx-ts/pdxscript": "^0.6.0"
  },
  "devDependencies": {
    "@pdx-ts/codegen-cwt": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeager-j/pdx-ts-sdk.git",
    "directory": "packages/sdk-testing"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "homepage": "https://github.com/yeager-j/pdx-ts-sdk/tree/main/packages/sdk-testing#readme",
  "bugs": {
    "url": "https://github.com/yeager-j/pdx-ts-sdk/issues"
  }
}
