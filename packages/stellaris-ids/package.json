{
  "name": "@pdx-ts/stellaris-ids",
  "version": "4.4.6-r.5",
  "description": "Vanilla Stellaris identifiers (technologies, scripted triggers/effects, sprites, sounds, ...), install-derived and version-pinned to the game — declaration-merges into @pdx-ts/sdk to check vanilla references at compile time",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "pdx-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./triggers": {
      "pdx-source": "./src/triggers.ts",
      "types": "./dist/triggers.d.ts",
      "default": "./dist/triggers.js"
    },
    "./effects": {
      "pdx-source": "./src/effects.ts",
      "types": "./dist/effects.d.ts",
      "default": "./dist/effects.js"
    },
    "./paths": {
      "pdx-source": "./src/paths.ts",
      "types": "./dist/paths.d.ts",
      "default": "./dist/paths.js"
    },
    "./gfx-ids": {
      "pdx-source": "./src/gfx-ids.ts",
      "types": "./dist/gfx-ids.d.ts",
      "default": "./dist/gfx-ids.js"
    },
    "./localization-keys": {
      "pdx-source": "./src/localization-keys.ts",
      "types": "./dist/localization-keys.d.ts",
      "default": "./dist/localization-keys.js"
    },
    "./enum-members": {
      "pdx-source": "./src/enum-members.ts",
      "types": "./dist/enum-members.d.ts",
      "default": "./dist/enum-members.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "PROVENANCE.md"
  ],
  "peerDependencies": {
    "@pdx-ts/sdk": ">=0.2.0 <1.0.0"
  },
  "devDependencies": {
    "@pdx-ts/codegen-vanilla": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeager-j/pdx-ts-sdk.git",
    "directory": "packages/stellaris-ids"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "homepage": "https://github.com/yeager-j/pdx-ts-sdk/tree/main/packages/stellaris-ids#readme",
  "bugs": {
    "url": "https://github.com/yeager-j/pdx-ts-sdk/issues"
  }
}
