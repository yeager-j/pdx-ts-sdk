---
import type { ScopeTransitionRow } from "../scope-reference.ts";
import { renderInlineMarkdown } from "../inline-markdown.ts";

interface Props {
  rows: readonly ScopeTransitionRow[];
}

const { rows } = Astro.props;
const renderedRows = await Promise.all(
  rows.map(async (row) => ({ ...row, summaryHtml: await renderInlineMarkdown(row.summary) }))
);
---

<p>
  Scope-link properties open a nested effect path in another scope. They are navigation, not
  effects, so they do not appear in the effect tables above.
</p>

{
  renderedRows.length === 0 ? (
    <p>The generated interface exposes no outgoing scope-link property.</p>
  ) : (
    <table>
      <caption>Scope-link properties available from this scope</caption>
      <thead>
        <tr>
          <th>Property</th>
          <th>Landing scope</th>
          <th>Generated interface</th>
          <th>Notes</th>
        </tr>
      </thead>
      <tbody>
        {renderedRows.map((row) => (
          <tr>
            <td>
              <code>{row.member}</code>
            </td>
            <td>
              <code>{row.toScope}</code>
            </td>
            <td>
              <code>{row.toInterface}</code>
            </td>
            <td>
              <Fragment set:html={row.summaryHtml} />
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  )
}
