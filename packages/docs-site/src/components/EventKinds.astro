---
import type { EventKindRow } from "../scope-reference.ts";

interface Props {
  rows: readonly EventKindRow[];
}

const { rows } = Astro.props;
---

{
  rows.length === 0 ? (
    <p>
      The SDK generates no event kind whose body runs in this scope. Enter it through another
      legal callback or scope transition instead.
    </p>
  ) : (
    <table>
      <caption>Generated event kinds for this body scope</caption>
      <thead>
        <tr>
          <th>Event kind</th>
          <th>Generated subtype</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <td>
              <code>{row.key}</code>
            </td>
            <td>
              <code>{row.subtype}</code>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  )
}
