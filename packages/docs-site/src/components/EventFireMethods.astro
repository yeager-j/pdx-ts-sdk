---
import type { ScriptMethodRow } from "../scope-reference.ts";
import EffectReferenceTable from "./EffectReferenceTable.astro";

interface Props {
  rows: readonly ScriptMethodRow[];
}

const { rows } = Astro.props;
---

<p>
  These methods fire typed event references. Their availability follows the generated receiving
  scopes, which is separate from the scope in which an event body runs.
</p>

{
  rows.length === 0 ? (
    <p>The generated interface has no legal event-fire method.</p>
  ) : (
    <EffectReferenceTable rows={rows} caption="Legal event-fire methods" />
  )
}
