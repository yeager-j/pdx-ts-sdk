---
/**
 * The shared body of one field table — used by `FieldTable.astro` for the
 * registry's own members and for every nested table, so the two cannot render
 * a row differently.
 */
import type { FieldRow } from "../field-table.ts";

interface Props {
  rows: readonly FieldRow[];
  /** Turns a sub-table id into the page anchor `FieldTable.astro` assigns it. */
  anchor: (id: string) => string;
}

const { rows, anchor } = Astro.props;
---

<table>
  <thead>
    <tr>
      <th>Member</th>
      <th>Game key</th>
      <th>Type</th>
      <th>Notes</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map((row) => (
        <tr>
          <td>
            <code>{row.member}</code>
            {!row.optional && <strong> (required)</strong>}
          </td>
          <td>{row.key === undefined ? <em>none</em> : <code>{row.key}</code>}</td>
          <td>
            <code>{row.type}</code>
            {row.subTable && (
              <>
                {" — "}
                <a href={`#${anchor(row.subTable)}`}>fields</a>
              </>
            )}
          </td>
          <td>
            {row.docs.join(" ")}
            {row.literals && (
              <>
                {row.docs.length > 0 && " "}
                One of:{" "}
                {row.literals.map((literal, index) => (
                  <>
                    {index > 0 && ", "}
                    <code>{literal}</code>
                  </>
                ))}
                .
              </>
            )}
            {row.refTypes && (
              <>
                {" References "}
                {row.refTypes.map((ref, index) => (
                  <>
                    {index > 0 && ", "}
                    <code>{ref}</code>
                  </>
                ))}
                {" ids."}
              </>
            )}
          </td>
        </tr>
      ))
    }
  </tbody>
</table>
