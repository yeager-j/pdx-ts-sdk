{
  // The docs site is the one workspace member outside the repo's single
  // NodeNext program: Next.js code resolves like its bundler does, so the
  // package carries its own bundler-moduleResolution config. The examples
  // under content/docs/ are still checked as members of the root program via
  // tsconfig.examples.json.
  "compilerOptions": {
    "target": "ES2024",
    // es2024, not esnext: the SDK's sources are checked under the root
    // program's es2024 libs, and a wider lib here would demand newer
    // built-in surfaces (ReadonlySet's ES2025 methods) from them.
    "lib": [
      "dom",
      "dom.iterable",
      "es2024"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // Resolves `@pdx-ts/*` to package sources, matching the webpack
    // `pdx-source` condition in next.config.mjs.
    "customConditions": [
      "pdx-source"
    ],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mjs",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "out",
    "content"
  ]
}
