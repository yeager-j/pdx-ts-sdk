{
  "name": "@pdx-ts/docs-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run examples:check && next dev --webpack",
    "examples:check": "node --conditions=pdx-source scripts/check-examples.ts",
    "build": "node ../create-stellaris-mod/scripts/generate-version.mjs && tsc -p tsconfig.examples.json && npm run examples:check && npm run scopes:check && next build --webpack && node scripts/check-built-docs.mjs",
    "preview": "next start",
    "scopes:check": "node --conditions=pdx-source scripts/generate-scope-pages.ts --check",
    "scopes:generate": "node --conditions=pdx-source scripts/generate-scope-pages.ts",
    "typecheck": "node ../create-stellaris-mod/scripts/generate-version.mjs && tsc --noEmit && tsc -p tsconfig.examples.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fuma-translate/react": "^1.0.2",
    "@fumadocs/base-ui": "^16.15.5",
    "@pdx-ts/sdk": "*",
    "@pdx-ts/stellaris-ids": "*",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "fumadocs-core": "^16.15.2",
    "fumadocs-mdx": "^15.4.0",
    "fumadocs-ui": "^16.15.5",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lucide-react": "^1.39.0",
    "next": "^16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.5",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^6.0.3"
  }
}
