{
  "name": "@pdx-ts/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for generating Stellaris mods",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "dist/src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/src/index.js"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./dist/src/testing/index.js"
    },
    "./testing/matchers": {
      "types": "./src/testing/matchers.ts",
      "default": "./dist/src/testing/matchers.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "codegen": "node tools/codegen/index.ts",
    "codegen:check": "node tools/codegen/index.ts && git diff --exit-code src/generated",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "node examples/hello-galaxy/build.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": "prettier --write"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.1.2",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.0.5"
  },
  "private": true
}
