{
  "name": "@pdx-ts/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for generating Stellaris mods",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "node examples/hello-galaxy/build.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": "prettier --write"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.1.2",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.0.5"
  },
  "private": true
}
