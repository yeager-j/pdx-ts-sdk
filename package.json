{
  "name": "pdx-ts-workspace",
  "version": "1.0.0",
  "description": "Workspace root for the PDX TypeScript modding packages",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "node scripts/clean.mjs",
    "codex:watch": "node scripts/watch-codex-reviews.mjs",
    "codegen": "node --conditions=pdx-source packages/codegen-cwt/src/index.ts",
    "codegen:check": "node --conditions=pdx-source packages/codegen-cwt/src/index.ts && git diff --exit-code packages/sdk/src/generated",
    "codegen:vanilla": "node --conditions=pdx-source packages/codegen-vanilla/src/index.ts",
    "codegen:vanilla:check": "node --conditions=pdx-source packages/codegen-vanilla/src/index.ts && git diff --exit-code packages/stellaris-ids/src packages/stellaris-ids/package.json",
    "codegen:verified-build": "node --conditions=pdx-source packages/codegen-vanilla/src/verified-build-projection.ts",
    "codegen:verified-build:check": "git ls-files --error-unmatch packages/sdk/src/generated/verified-build.ts packages/create-stellaris-mod/src/generated/verified-build.ts > /dev/null && node --conditions=pdx-source packages/codegen-vanilla/src/verified-build-projection.ts && git diff --exit-code packages/sdk/src/generated/verified-build.ts packages/create-stellaris-mod/src/generated/verified-build.ts",
    "generate:version": "node packages/create-stellaris-mod/scripts/generate-version.mjs",
    "docs:dev": "npm run dev --workspace @pdx-ts/docs-site",
    "docs:build": "npm run build --workspace @pdx-ts/docs-site",
    "docs:preview": "npm run preview --workspace @pdx-ts/docs-site",
    "docs:scopes:check": "npm run scopes:check --workspace @pdx-ts/docs-site",
    "docs:scopes:generate": "npm run scopes:generate --workspace @pdx-ts/docs-site",
    "corpus:extract": "node --conditions=pdx-source packages/corpus/src/extract.ts",
    "corpus:check": "node --conditions=pdx-source packages/corpus/src/check.ts",
    "coverage": "node --conditions=pdx-source packages/corpus/src/coverage-report.ts",
    "typecheck": "npm run generate:version && tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "npm run generate:version && vitest run",
    "test:vanilla": "node --conditions=pdx-source scripts/test-vanilla.mjs",
    "test:asset-scale": "node --expose-gc --conditions=pdx-source packages/sdk/tests/assets-scale.ts",
    "test:watch": "vitest",
    "example": "node --conditions=pdx-source examples/hello-galaxy/build.ts",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "scaffold": "node --conditions=pdx-source packages/create-stellaris-mod/src/bin.ts",
    "prepare": "node .husky/install.mjs && npm run generate:version",
    "release:prepare": "node --conditions=pdx-source scripts/release.mjs prepare",
    "release:check": "node --conditions=pdx-source scripts/release.mjs check",
    "release:publish": "npm publish --workspace create-stellaris-mod --workspace @pdx-ts/pdxscript --workspace @pdx-ts/sdk --workspace @pdx-ts/sdk-testing --workspace @pdx-ts/stellaris-ids --access public --tag latest"
  },
  "engines": {
    "node": ">=24"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": "prettier --write"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.3.0",
    "@types/semver": "^7.8.0",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.6",
    "semver": "^7.8.5",
    "typescript": "^6.0.3",
    "vitest": "^4.0.5"
  },
  "optionalDependencies": {
    "husky": "^9.1.7"
  }
}
