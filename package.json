{
  "name": "pdx-ts-workspace",
  "version": "1.0.0",
  "description": "Workspace root for the PDX TypeScript modding packages",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "codegen": "node tools/codegen/index.ts",
    "codegen:check": "node tools/codegen/index.ts && git diff --exit-code packages/sdk/src/generated",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "node examples/hello-galaxy/build.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": "prettier --write"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.1.2",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.0.5"
  }
}
