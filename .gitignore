/tmp
/out-tsc
/dist
packages/*/dist
examples/*/out

# The docs site's build output, caches, and generated example manifest.
packages/docs-site/.next/
packages/docs-site/.source/
packages/docs-site/.examples/
next-env.d.ts
*.tsbuildinfo

# Generated on install/typecheck/test/build by generate-version.mjs, so every
# SDK-touching PR does not conflict on a derived hash.
packages/create-stellaris-mod/src/generated/package-version.ts
packages/docs-site/lib/generated/sdk-docs-revision.ts

# Where codegen-cwt stages a generation before swapping it into src/generated.
packages/sdk/.codegen-staging/

# Unanchored: a workspace member whose dependency cannot hoist (a second major
# of something the root already has) gets its own nested node_modules.
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/.pnp
.pnp.js
.idea
.vscode/*
.DS_Store
.claude/worktrees/
.codex/environments/
.opencode