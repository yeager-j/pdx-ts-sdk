{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    // Resolve workspace packages to their sources. Their `exports`
    // otherwise point at `dist/`, which is what a published consumer
    // must get and what this repo never builds during development.
    "customConditions": ["pdx-source"],
    "declaration": true,
    "declarationMap": true,
    "erasableSyntaxOnly": true,
    "esModuleInterop": true,
    "noEmit": true,
    "rewriteRelativeImportExtensions": true,
    "incremental": false,
    "isolatedModules": true,
    "lib": ["es2024", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleDetection": "force",
    "moduleResolution": "NodeNext",
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node"]
  },
  // One program over every workspace member, `packages/stellaris-ids` and
  // `examples/` included: the SDK imports the identifier package's tables
  // (ADR-0006), so there is no longer a package-absent world to model by
  // holding it out.
  // The scaffolder's golden fixture project and its recorded goldens are a mod
  // author's program, not this one: they compile under their own tsconfig with
  // `@pdx-ts/sdk` symlinked in, which is what the matrix harness runs `tsc -p`
  // over.
  // The reference spike's browser half is the one directory in the repo that
  // is compiled by a bundler rather than by Node: it needs `jsx` and bundler
  // resolution, which this program deliberately does not have. It compiles
  // under `packages/reference-spike/tsconfig.app.json`. Everything else in
  // that package — the probe, the snapshot build, the Verified example, the
  // gates — stays here, which is what keeps the example's typecheck part of
  // the repository's ordinary `npm run typecheck`.
  "exclude": [
    "node_modules",
    "dist",
    "packages/reference-spike/src/app",
    "packages/reference-spike/vite.config.ts",
    "packages/reference-spike/starlight",
    "packages/stellaris-ids",
    "examples",
    "packages/create-stellaris-mod/tests/fixtures",
    "packages/create-stellaris-mod/tests/goldens"
  ]
}
