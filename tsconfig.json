{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    // Resolve workspace packages to their sources. Their `exports`
    // otherwise point at `dist/`, which is what a published consumer
    // must get and what this repo never builds during development.
    "customConditions": ["pdx-source"],
    "declaration": true,
    "declarationMap": true,
    "erasableSyntaxOnly": true,
    "esModuleInterop": true,
    "noEmit": true,
    "rewriteRelativeImportExtensions": true,
    "incremental": false,
    "isolatedModules": true,
    "lib": ["es2024", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleDetection": "force",
    "moduleResolution": "NodeNext",
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node"]
  },
  // One program over every workspace member, `packages/stellaris-ids` and
  // `examples/` included: the SDK imports the identifier package's tables
  // (ADR-0006), so there is no longer a package-absent world to model by
  // holding it out.
  // The scaffolder's golden fixture project and its recorded goldens are a mod
  // author's program, not this one: they compile under their own tsconfig with
  // `@pdx-ts/sdk` symlinked in, which is what the matrix harness runs `tsc -p`
  // over.
  // The docs site is an Astro program, not this one: the types for its virtual
  // modules (`astro:content`) are generated into `.astro/types.d.ts` by a
  // build, and `.astro` components are not TypeScript files. It extends
  // `astro/tsconfigs/strict` and gates itself with `astro check`, which
  // `npm run typecheck` calls through to.
  "exclude": [
    "node_modules",
    "dist",
    "packages/create-stellaris-mod/tests/fixtures",
    "packages/create-stellaris-mod/tests/goldens",
    "packages/docs-site"
  ]
}
