{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    // Resolve workspace packages to their sources. Their `exports`
    // otherwise point at `dist/`, which is what a published consumer
    // must get and what this repo never builds during development.
    "customConditions": ["pdx-source"],
    "declaration": true,
    "declarationMap": true,
    "erasableSyntaxOnly": true,
    "esModuleInterop": true,
    "noEmit": true,
    "rewriteRelativeImportExtensions": true,
    "incremental": false,
    "isolatedModules": true,
    "lib": ["es2024", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleDetection": "force",
    "moduleResolution": "NodeNext",
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node"]
  },
  "exclude": ["node_modules", "dist", "packages/stellaris-ids"]
}
