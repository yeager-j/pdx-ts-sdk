{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    // Resolve workspace packages to their sources. Their `exports`
    // otherwise point at `dist/`, which is what a published consumer
    // must get and what this repo never builds during development.
    "customConditions": ["pdx-source"],
    "declaration": true,
    "declarationMap": true,
    "erasableSyntaxOnly": true,
    "esModuleInterop": true,
    "noEmit": true,
    "rewriteRelativeImportExtensions": true,
    "incremental": false,
    "isolatedModules": true,
    "lib": ["es2024", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleDetection": "force",
    "moduleResolution": "NodeNext",
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node"]
  },
  // The package-absent world. `packages/stellaris-ids` is excluded so its
  // `declare module "@pdx-ts/sdk"` augmentation never joins this program, which
  // is what lets `packages/sdk/tests/vanilla-refs.test-d.ts` assert the
  // unchecked degradation. `examples/` is excluded for the mirror reason: the
  // example imports that package, and a module augmentation is global to a
  // program — one import anywhere would make this program the present world.
  // The example compiles under `packages/stellaris-ids/tsconfig.json` instead,
  // which is the world a real mod author is in.
  // The scaffolder's golden fixture project and its recorded goldens are a mod
  // author's program, not this one: they compile under their own tsconfig with
  // `@pdx-ts/sdk` symlinked in, which is what the matrix harness runs `tsc -p`
  // over.
  "exclude": [
    "node_modules",
    "dist",
    "packages/stellaris-ids",
    "examples",
    "packages/create-stellaris-mod/tests/fixtures",
    "packages/create-stellaris-mod/tests/goldens"
  ]
}
